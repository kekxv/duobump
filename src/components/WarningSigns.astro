---
import warnings from '../data/warning-signs.json';
import { url } from '../lib/urls';
import Icon from './Icon.astro';
---

<section class="warning-section" aria-labelledby="warning-heading">
  <div class="section-heading">
    <div>
      <span class="eyebrow">NOTICE THE CHANGE, KNOW THE NEXT STEP</span>
      <h2 id="warning-heading">需要留意的 9 类异常信号</h2>
      <p>症状可能重叠，也可能不典型；没出现典型表现，不能据此排除风险。</p>
    </div>
  </div>
  <div class="warning-grid">
    {warnings.map((warning) => (
      <article id={`warning-${warning.id}`} data-warning class="warning-card">
        <span class:list={['warning-level', { critical: warning.urgency === 'emergency' }]}>
          {warning.urgency === 'emergency' ? '急救警示' : '及时联系产科'}
        </span>
        <h3>{warning.title}</h3>
        <p class="warning-stage">{warning.stage}</p>
        <ul>
          {warning.signals.map((signal) => (
            <li>{signal}</li>
          ))}
        </ul>
        <p>
          <strong>可能的原因：</strong>
          {warning.possibilities}
        </p>
        <p class="warning-action">
          <strong>怎么做：</strong>
          {warning.action}
        </p>
        <p class="warning-uncertainty">
          <strong>如何理解风险：</strong>
          {warning.uncertainty}
        </p>
        <div class="warning-refs">
          {warning.sourceIds.map((id, index) => (
            <a href={`${url('/references/')}#${id}`}>
              参考资料 {index + 1} <Icon name="arrow" size={11} />
            </a>
          ))}
        </div>
      </article>
    ))}
  </div>
</section>
<style>
  .warning-section {
    margin-top: 36px;
  }
  .warning-section h2 {
    font-size: 23px;
    line-height: 1.6;
  }
  .warning-section .section-heading p {
    font-size: 13px;
    line-height: 1.9;
    margin-top: 9px;
    color: #637158;
  }
  .warning-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 20px;
  }
  .warning-card {
    border: 1px solid #e0e5d8;
    background: #fff;
    border-radius: 20px;
    padding: 24px;
    scroll-margin-top: 100px;
  }
  .warning-level {
    display: inline-block;
    background: #edf2e5;
    color: #40583d;
    padding: 5px 11px;
    border-radius: 20px;
    font-size: 11px;
  }
  .warning-level.critical {
    background: #f9e9df;
    color: #844e36;
  }
  .warning-card h3 {
    font-size: 19px;
    line-height: 1.6;
    margin-top: 14px;
  }
  .warning-card p,
  .warning-card li {
    font-size: 13px;
    line-height: 1.95;
    margin-top: 10px;
  }
  .warning-stage {
    color: #627057;
  }
  .warning-card ul {
    margin: 15px 0;
    padding-left: 18px;
  }
  .warning-card li {
    list-style: disc;
    margin-top: 3px;
  }
  .warning-action {
    background: #faf2e8;
    color: #6e4f36;
    padding: 14px;
    border-radius: 10px;
  }
  .warning-uncertainty {
    color: #5d6b53;
  }
  .warning-refs {
    display: flex;
    flex-wrap: wrap;
    gap: 16px;
    margin-top: 17px;
    font-size: 12px;
    color: #506744;
  }
  .warning-refs a {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    text-decoration: underline;
    text-underline-offset: 3px;
  }
  @media (max-width: 700px) {
    .warning-grid {
      grid-template-columns: 1fr;
    }
    .warning-card {
      padding: 20px;
    }
    .warning-section h2 {
      font-size: 20px;
    }
  }
</style>
