{
  "name": "duobump",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "astro dev --host 0.0.0.0",
    "start": "npm run dev",
    "check": "astro check",
    "validate:content": "tsx scripts/validate-content.ts",
    "verify:release": "tsx scripts/validate-content.ts --release",
    "test": "vitest run",
    "test:watch": "vitest",
    "build": "npm run validate:content && astro build && tsx scripts/build-search.ts && tsx scripts/build-router.ts",
    "preview": "astro preview --host 0.0.0.0",
    "test:e2e": "playwright test",
    "format": "prettier --write src tests scripts astro.config.mjs playwright.config.ts vitest.config.ts"
  },
  "engines": {
    "node": ">=22.23.4"
  },
  "dependencies": {
    "@astrojs/markdown-satteri": "0.4.7",
    "@tailwindcss/vite": "^4.3.5",
    "astro": "^7.4.7",
    "pagefind": "^1.6.0",
    "tailwindcss": "^4.3.5",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.12",
    "@axe-core/playwright": "^4.14.0",
    "@playwright/test": "^1.65.0",
    "@types/node": "^26.6.6",
    "lighthouse": "^13.6.0",
    "prettier": "^3.9.10",
    "prettier-plugin-astro": "^1.1.2",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "vitest": "^5.1.0",
    "yaml": "^2.9.1"
  }
}
